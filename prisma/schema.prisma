generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Integration {
  id         String    @id @default(cuid())
  provider   String    @unique
  enabled    Boolean   @default(false)
  config     String    @default("{}")
  lastSyncAt DateTime?
  lastStatus String?
  lastError  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model CallRecord {
  id          String   @id @default(cuid())
  externalId  String   @unique
  direction   String
  status      String
  agentName   String?
  fromNumber  String?
  toNumber    String?
  durationSec Int      @default(0)
  startedAt   DateTime
  isDemo      Boolean  @default(false)
  raw         String?
  createdAt   DateTime @default(now())

  @@index([startedAt])
}

model WhatsAppMessage {
  id         String   @id @default(cuid())
  externalId String?  @unique
  direction  String
  status     String?
  agentName  String?
  contact    String?
  sentAt     DateTime
  isDemo     Boolean  @default(false)
  raw        String?
  createdAt  DateTime @default(now())

  @@index([sentAt])
}

enum ProspectStatus {
  NOVO
  CONTATADO
  QUALIFICADO
  DESCARTADO
}

/// Uma busca configurada e disparada contra o Apollo (filtros usados + quando rodou).
model ProspectSearch {
  id             String            @id @default(cuid())
  name           String
  employeeRanges String
  technologies   String
  locations      String
  keywords       String?
  resultsCount   Int               @default(0)
  createdAt      DateTime          @default(now())
  companies      ProspectCompany[]
}

/// Empresa de e-commerce prospectada (via Apollo ou lançamento manual), com o
/// carrinho/plataforma detectado e o status no funil de prospecção.
model ProspectCompany {
  id                 String          @id @default(cuid())
  apolloOrgId        String?         @unique
  domain             String?         @unique
  name               String
  linkedinUrl        String?
  websiteUrl         String?
  employeeCount      Int?
  employeeRange      String?
  industry           String?
  city               String?
  state              String?
  country            String?
  technologies       String          @default("[]")
  ecommercePlatforms String          @default("[]")
  status             ProspectStatus  @default(NOVO)
  notes              String?
  source             String          @default("apollo")
  searchId           String?
  search             ProspectSearch? @relation(fields: [searchId], references: [id])
  contacts           ProspectContact[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([status])
  @@index([employeeCount])
  @@index([createdAt])
}

enum ContactPhoneStatus {
  NAO_SOLICITADO
  PENDENTE
  DISPONIVEL
  INDISPONIVEL
}

/// Decisor (pessoa) de uma empresa prospectada, encontrado por cargo/nome no
/// Apollo. O telefone só é buscado sob demanda (consome crédito Apollo e a
/// revelação é assíncrona — fica PENDENTE até o webhook confirmar).
model ProspectContact {
  id             String             @id @default(cuid())
  apolloPersonId String?            @unique
  companyId      String
  company        ProspectCompany    @relation(fields: [companyId], references: [id])
  name           String
  title          String?
  seniority      String?
  linkedinUrl    String?
  email          String?
  phone          String?
  phoneStatus    ContactPhoneStatus @default(NAO_SOLICITADO)
  phoneRequestId String?            @unique
  status         ProspectStatus     @default(NOVO)
  notes          String?
  source         String             @default("apollo")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([companyId])
  @@index([status])
}
