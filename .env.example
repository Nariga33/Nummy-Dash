# Banco de dados (SQLite por padrão; troque para Postgres em produção se preferir)
DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth
# Gere um valor com: openssl rand -base64 32
AUTH_SECRET="troque-este-valor-por-um-segredo-aleatorio"

# Chave usada para criptografar credenciais de integração (API4COM, WhatsApp) salvas no banco
# Gere um valor com: openssl rand -hex 32
INTEGRATIONS_ENCRYPTION_KEY="troque-este-valor-por-um-segredo-aleatorio-de-32-bytes"

# Conta administradora criada automaticamente no primeiro `npm run db:seed`
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@empresa.com"
ADMIN_PASSWORD="troque-esta-senha"

# Token que sistemas externos (ex: Evolution API, Z-API, CRM) devem enviar
# no header "x-webhook-token" ao chamar /api/webhooks/whatsapp
WHATSAPP_WEBHOOK_TOKEN="troque-este-token"
